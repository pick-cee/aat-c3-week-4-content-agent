{
  "name": "koya-content-agent",
  "version": "1.0.0",
  "private": true,
  "description": "AI content research and publishing agent — idea to reviewed, channel-ready, grounded content.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "tsx scripts/db-push.ts",
    "db:seed": "tsx --require ./scripts/stub-server-only.cjs scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "broken-pack": "tsx --require ./scripts/stub-server-only.cjs scripts/broken-input-pack.ts",
    "verify:selects": "tsx scripts/verify-selects.ts",
    "verify:schemas": "tsx --require ./scripts/stub-server-only.cjs scripts/verify-schemas.ts",
    "verify:grants": "tsx scripts/verify-grants.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "resend": "^6.1.2",
    "server-only": "^0.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^17.2.2",
    "pg": "^8.16.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
